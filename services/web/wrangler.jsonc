{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mitoshi-web",
  "main": "src/index.ts",
  // workers.dev stays on as a second address for the same Worker (local development uses mitoshi.xyz/relay).
  "workers_dev": true,
  "preview_urls": false,
  // mitoshi.xyz (its zone is on Cloudflare). Zone settings that live outside this file, set 2026-10-23:
  //   - a redirect rule sends www.mitoshi.xyz/* to the apex with a 301, before assets or this Worker;
  //   - Web Analytics for the zone is off (automatic setup disabled), and so are NEL, email obfuscation
  //     and server-side excludes. Every page also says no-transform (apps/web/scripts/headers.mjs), so
  //     the proxy cannot add a script to it even if one of these is switched back on.
  "routes": [
    { "pattern": "mitoshi.xyz", "custom_domain": true },
    { "pattern": "www.mitoshi.xyz", "custom_domain": true },
    // The judges' desks (features/judge): same Worker and app, an origin of its own so a desk never shares storage.
    { "pattern": "judge.mitoshi.xyz", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-01",
  // The static app. Headers (CSP with per-page script hashes, COOP/COEP) come from out/_headers.
  "assets": {
    "directory": "../../apps/web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // "/" so the judges' origin can answer its front page with the desk gate (every other host gets index.html), and
    // "/j/*" for the judges' short link.
    "run_worker_first": ["/", "/j/*", "/relay/*", "/_next/static/*", "/docs", "/docs/*"]
  },
  // The relay runs in Europe, so the address the gateway sees says nothing about where a user is.
  "placement": { "mode": "targeted", "region": "aws:eu-west-1" },
  "vars": { "GATEWAY_URL": "https://mitoshi-gateway.vercel.app" },
  // Live public market data: one feed object per venue (see src/live.ts).
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveFeed" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveFeed"] }],
  // No request logs: the relay never keeps who asked.
  "observability": { "enabled": false }
}
